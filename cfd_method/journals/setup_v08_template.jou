; setup_v08.jou -- case setup for the v08 rotor: v06 aerodynamics EXACTLY,
; trailing edge 0.020 c -> 0.012 c.
;
; GENERATED by make_v08_journals.py from setup_v06e.jou by substitution only.
; The ONLY differences are the input volume mesh, the output case name, and the
; fluid cell-zone name, which is MEASURED from the v08 volume mesh because the
; mesher assigns it (v03 fluid-1107, v04 fluid-1091, v06e fluid-1268, v08 fluid-1546).
;
; EVERY physics setting is unchanged and deliberately so: k-omega SST, ideal gas +
; Sutherland, the same operating pressure, the same pressure-far-field and
; pressure-outlet conditions, the same MRF cylinder register (r = 2.0, z = -1..1)
; and the same rotation omega = -135.559045147 rad/s about (0,0,1). The ONLY
; variable changed between the v06e result and this one is TRAILING-EDGE THICKNESS.
; Anything else would confound the comparison.
/file/read-case
openfan_v08_vol.msh.h5
(system "echo MARK_MESHREAD")
/mesh/quality
(system "echo MARK_QUALITY_IN")

; ---- models: energy, k-omega SST, gauge pressure 0, ideal gas + Sutherland
;      source: sol05_models_save.jou
/define/models/energy
yes
no
yes
yes
yes
(system "echo MARK_ENERGY")
/define/models/viscous/kw-sst
yes
(system "echo MARK_SST")
/define/operating-conditions/operating-pressure
0
(system "echo MARK_OPPRESS")
/define/materials/change-create
air
air
yes
ideal-gas
no
no
yes
sutherland
three-coefficient-method
1.716e-05
273.11
110.56
no
no
no
(system "echo MARK_MATERIAL")

; ---- whole domain rotating first, so the split inherits the frame
;      source: sol11_frame.jou
/define/boundary-conditions/fluid
fluid-1546
no
no
no
yes
-1
no
-135.559045147
no
0
