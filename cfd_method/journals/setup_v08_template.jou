(system "echo MARK_FARFIELD")
/define/boundary-conditions/pressure-outlet
outlet
yes
no
23842.27292
no
218.808
no
yes
no
no
yes
0.1
1
no
yes
no
no
no
(system "echo MARK_OUTLET")

; ---- MRF: mark a compact cylinder around the rotor and split the cell zone
;      source: mrf10_sep.jou. The split is CONFORMAL -- the shared faces stay an
;      interior zone, node-matched, so there is no interface interpolation error.
/solve/cell-registers/add
rotorzone
type
cylinder
radius
2.0
axis-begin
0
0
-1.0
axis-end
0
0
1.0
inside?
yes
q
q
(system "echo MARK_REGISTER")
/mesh/modify-zones/sep-cell-zone-mark
fluid-1546
rotorzone
yes
(system "echo MARK_SPLIT")

; ---- reference frames: rotor zone spins, far field is stationary
;      source: mrf12_frames.jou, but with ONE command instead of two.
;
;      sep-cell-zone-mark gives the NEW zone an auto-generated suffix that
;      this script cannot predict -- the first build produced
;      'fluid-288:011' and the number is assigned by Fluent. Naming it
;      here would target a zone that may not exist.
;
;      It does not need naming. The whole domain was already set rotating
;      above, and BOTH halves inherit that on the split, so the new
;      (marked, compact, inside-the-cylinder) zone is ALREADY at omega.
;      Only the outer remainder -- which keeps the original name -- has to
;      be set back to zero. Verified against the first build, where
;      'fluid-288' was the 95,650-cell far field and 'fluid-288:011' the
;      compact rotor zone at r 0.565-2.137 m, z -1.114-1.687 m.
;      The written case is re-read afterwards to confirm both frames.
/define/boundary-conditions/fluid
fluid-1546
no
no
no
yes
-1
no
0
no
0
no
0
no
0
no
0
no
0
