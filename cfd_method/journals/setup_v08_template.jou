0
no
1
"none"
no
no
no
no
no
(system "echo MARK_FRAME")

; ---- boundary conditions: M 0.75 at 10,668 m ISA, axial (0,0,1)
;      source: sol19_bc.jou
/define/boundary-conditions/pressure-far-field
inlet
no
23842.27292
no
0.75
no
218.808
yes
no
0
