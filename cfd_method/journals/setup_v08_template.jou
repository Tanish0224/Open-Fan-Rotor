no
(system "echo MARK_STATORFRAME")

/define/boundary-conditions/list-zones
(system "echo MARK_ZONES")
/file/write-case
openfan_v08_mrf.cas.h5
(system "echo MARK_CASEWRITTEN")
exit
yes
