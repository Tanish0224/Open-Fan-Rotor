; solve_v08.jou -- solve the thin-trailing-edge rotor at the DESIGN speed (Stage 38).
;
; GENERATED by make_v08_journals.py from solve_v06e.jou by substitution only.
; omega, boundary conditions, models, schemes, checkpoint cadence and the
; (inert -- see the module docstring) under-relaxation lines are IDENTICAL to the
; v06e run this is compared against. The ONLY physical difference is TRAILING-EDGE
; THICKNESS: 0.020 c -> 0.012 c. Chord, twist, camber, t/c, Cl_design, sweep, blade
; count, radius, hub and RPM are all bit-identical (max|v06-v08| = 0.000e+00).
;
; PRE-REGISTERED, before this geometry was built --
; 01_design/results/v08_prediction.json:
;     eta_p(v08) = 0.545 - 0.570, central 0.558
;     FALSIFIED if Fluent returns eta_p <= 0.5298 (no improvement).
;     SUSPECT if > 0.60 -- audit for an unintended change before reporting.
;     Q MUST FALL. If it does not, the mechanism is wrong even if eta rises.
;
; The mechanism under test: Stage 38 decomposed the MEASURED v06e span-mean sectional
; Cd = 0.0452 and attributed 0.0136 (30.0%) to blunt-base drag from the 0.020 c
; trailing edge, using Hoerner dCd = 0.135 (h/c) / Cd_f^(1/3). That TE is a meshing
; artefact carried since Stage 29; PRIME specifies 0.006 c.
/file/read-case
openfan_v08_mrf.cas.h5
(system "echo MARK_CASEREAD")
/mesh/quality
(system "echo MARK_QUALITY")

; ---- stage 1: first-order ramp through the MRF start-up transient -----------
(rpsetvar 'mom/scheme 0)
(rpsetvar 'k/scheme 0)
(rpsetvar 'omega/scheme 0)
(rpsetvar 'temperature/scheme 0)
(rpsetvar 'density/scheme 0)
(rpsetvar 'pressure/relax 0.3)
(rpsetvar 'mom/relax 0.5)
(rpsetvar 'k/relax 0.7)
(rpsetvar 'omega/relax 0.7)
(rpsetvar 'temperature/relax 0.9)
(rpsetvar 'body-force/relax 0.7)
(display (list 'STAGE1 'mom-scheme (rpgetvar 'mom/scheme) 'p-relax (rpgetvar 'pressure/relax)))
(newline)
/solve/initialize/compute-defaults/pressure-far-field
inlet
; NOTE: on a FRESH case (no prior data) initialize-flow does NOT ask for
; confirmation, so the `yes` that solve_c6n.jou carried here becomes a stray
; command and aborts the journal with `invalid command: yes`. Removed.
/solve/initialize/initialize-flow
(system "echo MARK_INIT")
/solve/iterate
60
/file/write-data
openfan_v08_s1.dat.h5
(system "echo MARK_S1")
/report/forces/wall-forces
yes
0
0
1
no
/report/forces/wall-moments
yes
0
0
0
0
0
1
no
(system "echo MARK_S1_REP")

; ---- stage 2: second order -- this is what the result is quoted from --------
(rpsetvar 'mom/scheme 1)
(rpsetvar 'k/scheme 1)
(rpsetvar 'omega/scheme 1)
(rpsetvar 'temperature/scheme 1)
(rpsetvar 'density/scheme 1)
(display (list 'STAGE2 'mom-scheme (rpgetvar 'mom/scheme)))
(newline)
(system "echo MARK_STAGE2")

/solve/iterate
60
/file/write-data
openfan_v08_s2.dat.h5
(system "echo MARK_S2")
/report/forces/wall-forces
yes
0
0
1
no
/report/forces/wall-moments
yes
0
